{
	"timezone": "America/New_York",
	"scope": {
		"_comment": "detectors only flag inside these local hours on these days; evenings are recreation, out of scope",
		"hours": [8, 18],
		"days": ["Mon", "Tue", "Wed", "Thu", "Fri"]
	},
	"dwell": {
		"idleGraceMs": 300000,
		"maxSilentDwellMs": 7200000
	},
	"session": {
		"gapMs": 1800000,
		"bounceMs": 3000,
		"stayBreakMs": 60000
	},
	"hosts": {
		"_comment": "Empty by design: host classification is personal and is NOT committed to this public repo. Put your own lists in config.hosts.local.json (gitignored) and the scripts will merge them. Product-side this is per-user settings, SPEC 13 'User configuration' (m24).",
		"focus": [],
		"drift": [],
		"shopping": [],
		"newtab": []
	},
	"detectors": {
		"quickCheckLoop": {
			"categories": ["drift"],
			"windowMs": 1200000,
			"minOpens": 3,
			"maxStayMs": 90000,
			"minAbsenceMs": 60000
		},
		"tabSwitchFlicker": {
			"windowMs": 60000,
			"minSwitches": 6,
			"maxStayMs": 8000,
			"minDistinctTabs": 2,
			"requireDriftTab": true,
			"driftCategories": ["drift"]
		},
		"postFrictionDrift": {
			"minFocusStayMs": 120000,
			"maxLagMs": 30000,
			"userInitiatedOnly": true,
			"driftCategories": ["drift", "shopping"]
		},
		"chainSpiral": {
			"categories": ["drift"],
			"minLinkNavs": 8,
			"minDurationMs": 900000
		},
		"returnVelocityCollapse": {
			"driftCategories": ["drift"],
			"window": 4,
			"collapsedGapMs": 300000,
			"baselineFactor": 3,
			"minBaselineGapMs": 120000
		},
		"sunkSession": {
			"driftCategories": ["drift"],
			"minDriftShare": 0.6,
			"minDriftMs": 2700000
		}
	}
}
