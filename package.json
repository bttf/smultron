{
	"name": "smultron",
	"private": true,
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "pnpm --filter web dev",
		"test": "pnpm -r --if-present test",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "pnpm -r --if-present typecheck",
		"db:generate": "pnpm --filter web db:generate",
		"db:migrate": "pnpm --filter web db:migrate"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6"
	},
	"pnpm": {
		"overrides": {
			"vite": "^7.3.6"
		}
	}
}
